# Safe local defaults. The SQLite workspace is created automatically inside
# MAF_DATA_DIR; no database server or DATABASE_URL is needed.
HOST=127.0.0.1
PORT=3000
MAF_DATA_DIR=./data
# Required only after adding access control in front of a non-loopback server.
# MAF_ALLOW_UNAUTHENTICATED_REMOTE=false

# Optional: provide a stable 32-byte secret as base64url, base64, hex, or a
# passphrase. If omitted, MAF creates a private key inside MAF_DATA_DIR.
# MAF_CONFIG_ENCRYPTION_KEY=

# Only needed if the database intentionally contains multiple workspaces.
# APP_WORKSPACE_ID=1

# Provider request controls. The legacy MAF_INTEGRATION_TIMEOUT_MS applies one
# value to all three categories when set, but the split values are recommended.
MAF_INTEGRATION_TEST_TIMEOUT_MS=30000
MAF_LLM_TIMEOUT_MS=120000
MAF_IMAGE_TIMEOUT_MS=180000
MAF_IMAGE_DOWNLOAD_LIMIT_BYTES=26214400

# API connections can be managed in Settings. Environment-managed connections
# are atomic and appear read-only in the interface: when any MAF_<CAPABILITY>_*
# value is set, provide the key and identity values in the environment as well.
# Saved keys are never combined with an environment provider or base URL.

# Intelligence example (OpenAI-compatible endpoint)
# MAF_INTELLIGENCE_PROVIDER=openai-compatible
# MAF_INTELLIGENCE_API_KEY=
# MAF_INTELLIGENCE_MODEL=
# MAF_INTELLIGENCE_BASE_URL=https://api.openai.com/v1
# MAF_INTELLIGENCE_ENABLED=true

# Web research (Tavily)
# MAF_SEARCH_PROVIDER=tavily
# MAF_SEARCH_API_KEY=
# MAF_SEARCH_BASE_URL=https://api.tavily.com
# MAF_SEARCH_ENABLED=true

# Image generation example (OpenAI-compatible endpoint)
# MAF_IMAGE_PROVIDER=openai-compatible
# MAF_IMAGE_API_KEY=
# MAF_IMAGE_MODEL=
# MAF_IMAGE_BASE_URL=https://api.openai.com/v1
# MAF_IMAGE_ENABLED=true
