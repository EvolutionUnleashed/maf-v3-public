{
  "name": "maf-v3",
  "version": "3.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --define:process.env.NODE_ENV=\"\\\"production\\\"\" --outdir=dist",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "security:verify-config": "node scripts/security-verify-config.mjs",
    "security:verify-lock": "node scripts/security-verify-lock.mjs",
    "security:verify-cargo": "node scripts/security-verify-cargo-lock.mjs",
    "security:verify": "node scripts/security-verify-config.mjs && node scripts/security-verify-lock.mjs && node scripts/security-verify-cargo-lock.mjs",
    "security:checksums": "node scripts/security-checksums.mjs",
    "desktop:prepare": "node scripts/desktop-prepare.mjs",
    "desktop:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-doctor.ps1",
    "desktop:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-release.ps1",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit migrate"
  },
  "dependencies": {
    "@trpc/server": "11.18.0",
    "better-sqlite3": "12.4.1",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "mammoth": "1.12.0",
    "pdf-parse": "2.4.5",
    "superjson": "1.13.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tailwindcss/vite": "4.1.14",
    "@tanstack/react-query": "5.90.2",
    "@tauri-apps/cli": "2.11.4",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.3",
    "@types/node": "24.7.0",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.5",
    "esbuild": "0.25.10",
    "lucide-react": "0.453.0",
    "prettier": "3.6.2",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wouter": "3.7.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.16.0"
}
